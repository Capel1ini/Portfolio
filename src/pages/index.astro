---
import PageLayout from "@/layouts/Base.astro";
import SocialList from "@/components/SocialList.astro";
---
<PageLayout meta={{ title: "Home" }}>
  <section data-pagefind-body>
    <p class="text-accent mb-4">Computer Science / University of South Florida</p>
    <h1 class="title mb-6">Hi, I'm Asim.</h1>
    <p class="mb-4 leading-relaxed">I'm a Computer Science undergraduate at USF, graduating in December 2027. I'm building my software development skills through coursework, personal projects, and The Odin Project.</p>
    <SocialList />
  </section>
  <section class="mt-14" aria-labelledby="projects-title">
    <h2 id="projects-title" class="title mb-6 text-xl">What I'm working on</h2>
    <div class="rounded-lg border border-current/20 p-6">
      <p class="text-accent mb-3 text-xs">PERSONAL PROJECT · IN DEVELOPMENT</p>
      <h3 class="title mb-3 text-lg">WeightLoss</h3>
      <p class="mb-4 leading-relaxed">A weight and nutrition project that I'm developing toward a full-stack tracker. The existing repository contains a Flask calculator; saved meal logs, weigh-ins, and progress charts are planned next.</p>
      <a class="cactus-link" href="https://github.com/Capel1ini/WeightLoss">View repository →</a>
    </div>
    <p class="mt-5"><a class="cactus-link" href="/projects/">More projects and coursework →</a></p>
  </section>
  <section class="mt-14" aria-labelledby="background-title">
    <h2 id="background-title" class="title mb-5 text-xl">Background</h2>
    <p class="mb-4 leading-relaxed">My studies include data structures, algorithms, computer architecture, and artificial intelligence. I've worked with Python, C++, SQL, and Arduino, and previously completed an IT internship at Indesore Trading.</p>
    <a class="cactus-link" href="/about/">More about me →</a>
  </section>
  <section class="mt-14" aria-labelledby="contact-title">
    <h2 id="contact-title" class="title mb-5 text-xl">Get in touch</h2>
    <a class="cactus-link" href="mailto:asimhossain@usf.edu">asimhossain@usf.edu</a>
  </section>
</PageLayout>
